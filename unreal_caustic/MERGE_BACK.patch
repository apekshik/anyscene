+            src = mp.inputs["Vector"].links[0].from_node if mp.inputs["Vector"].is_linked else None
+        else:
+            lay["mapping"] = None
+            src = mp
+        # Coordinate source: TexCoord Normal -> x/z, y/z (perspective projector) is the standard spot gobo.
+        c = "unknown"
+        if src is not None and src.type == "COMBXYZ":
+            ins = [src.inputs[i].links[0].from_node if src.inputs[i].is_linked else None for i in (0, 1)]
+            if all(n is not None and n.type == "MATH" and n.operation == "DIVIDE" for n in ins):
+                seps = {l.from_node.type for n in ins for i in n.inputs[:2] for l in i.links}
+                tc = {l.from_node for n in ins for i in n.inputs[:2] for l in i.links if l.from_node.type == "SEPXYZ"}
+                if seps == {"SEPXYZ"} and len(tc) == 1:
+                    sep = next(iter(tc))
+                    ln = sep.inputs[0].links[0] if sep.inputs[0].is_linked else None
+                    if ln and ln.from_node.type == "TEX_COORD":
+                        c = "normal_projective" if ln.from_socket.name == "Normal" else ln.from_socket.name.lower() + "_projective"
+        elif src is not None and src.type == "TEX_COORD":
+            c = src.outputs[0].name.lower()
+            for s in src.outputs:
+                if s.is_linked:
+                    c = s.name.lower() + "_raw"
+        coord = c if coord == "unknown" else coord
+        if c != coord:
+            warns.append(f"layers use different coordinates ({coord} vs {c})")
+        layers.append(lay)
+    em = next((n for n in nt.nodes if n.type == "EMISSION"), None)
+    g = {"coord": coord, "layers": layers, "fps": fps}
+    try:
+        f = _reduce_strength(em.inputs["Strength"], layers, o.name) if em else None
+    except ValueError as ex:
+        warns.append(str(ex))
+        f = None
+    if f is None:  # fall back to an equal-weight average of the layers, unit gain
+        f = {"w": {i: 1.0 / len(layers) for i in range(len(layers))}, "bias": 0.0, "gamma": 1.0, "gain": 1.0, "clamp": False}
