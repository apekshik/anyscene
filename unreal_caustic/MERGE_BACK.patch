+def _fcurves(idblock):
+    """All F-curves of an ID's action (Blender 5 layered actions: layers -> strips -> channelbag(slot))."""
+    ad = getattr(idblock, "animation_data", None)
+    act = ad.action if ad else None
+    if act is None:
+        return []
+    out = list(getattr(act, "fcurves", []) or [])
+    if not out and hasattr(act, "layers"):
+        for ly in act.layers:
+            for st in ly.strips:
+                cb = st.channelbag(ad.action_slot) if ad.action_slot else None
+                if cb:
+                    out += list(cb.fcurves)
+    return out
+
