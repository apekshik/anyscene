+                warns.append("mapping X/Y rotation ignored")
+            chans = {}
+            for key, sock, idx in (("loc_x", "Location", 0), ("loc_y", "Location", 1), ("rot", "Rotation", 2),
+                                   ("scale_x", "Scale", 0), ("scale_y", "Scale", 1)):
+                si = list(mp.inputs).index(mp.inputs[sock])
