+def export_image_file(img, sub="gobo"):
+    """A (possibly packed) image -> <OUT>/<sub>/<name>.<ext>; returns the path relative to OUT."""
+    d = os.path.join(OUT, sub)
+    os.makedirs(d, exist_ok=True)
+    base = os.path.basename(bpy.path.abspath(img.filepath)) or img.name
+    stem, ext = os.path.splitext(base)
+    ext = ext.lower() if ext.lower() in (".png", ".jpg", ".jpeg", ".tga", ".exr", ".tif", ".tiff") else ".png"
+    dst = os.path.join(d, safe(stem) + ext)
+    if not os.path.exists(dst):
+        if img.packed_file:
+            with open(dst, "wb") as fo:
+                fo.write(img.packed_file.data)
+        elif os.path.exists(bpy.path.abspath(img.filepath)):
+            with open(bpy.path.abspath(img.filepath), "rb") as fi, open(dst, "wb") as fo:
+                fo.write(fi.read())
+        else:  # generated / missing on disk: write the pixels
+            dst = os.path.join(d, safe(stem) + ".png")
+            im2 = img.copy()
+            save_png(im2, dst)
+            bpy.data.images.remove(im2)
+    return os.path.relpath(dst, OUT)
