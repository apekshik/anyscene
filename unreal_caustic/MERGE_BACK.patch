+def gobo_entry(o):
+    """Projected-texture (gobo) light: the image layers, their Mapping transform and its animation fitted to drift +
+    sines, and the strength chain reduced to gain * (sum w_i tex_i + bias)^gamma. None if the light has no image."""
+    L = o.data
