+def export_ies(nd, light_name):
+    """IES profile -> <OUT>/ies/<name>.ies (external file copied, internal text datablock written). Returns the
+    path relative to OUT, or None."""
+    d = os.path.join(OUT, "ies")
+    os.makedirs(d, exist_ok=True)
+    try:
+        if nd.mode == "EXTERNAL":
+            src = bpy.path.abspath(nd.filepath)
+            if not os.path.exists(src):
+                log("ies missing", light_name, src)
+                return None
+            dst = os.path.join(d, safe(os.path.splitext(os.path.basename(src))[0]) + ".ies")
+            if not os.path.exists(dst):
+                with open(src, "rb") as fi, open(dst, "wb") as fo:
+                    fo.write(fi.read())
+        else:
+            if nd.ies is None:
+                return None
+            dst = os.path.join(d, safe(nd.ies.name.rsplit(".", 1)[0]) + ".ies")
+            with open(dst, "w", encoding="utf-8") as fo:
+                fo.write(nd.ies.as_string())
+    except OSError as ex:
+        log("ies export failed", light_name, ex)
+        return None
+    return os.path.relpath(dst, OUT)
