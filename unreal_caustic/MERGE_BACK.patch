+def fit_channel(t, y, n_sines=2, fmin=0.01, fmax=1.5, step=0.002):
+    """y(t) ~ c0 + v t + sum_k A_k sin(2 pi f_k t + phi_k), greedy frequency search + joint linear least squares.
+    Returns {"c0", "v", "sines": [[A, f, phi], ...], "rms"} (t in seconds)."""
+    t = np.asarray(t, np.float64)
+    y = np.asarray(y, np.float64)
+    cols = [np.ones_like(t), t]
+    freqs = []
+    grid = np.arange(fmin, fmax, step)
+    for _ in range(n_sines):
+        best = None
+        for f in grid:
+            if any(abs(f - g) < 2 * step for g in freqs):
+                continue
+            w = 2 * math.pi * f
+            A = np.vstack(cols + [np.sin(w * t), np.cos(w * t)]).T
+            c, res, *_ = np.linalg.lstsq(A, y, rcond=None)
+            r = float(((A @ c - y) ** 2).sum())
+            if best is None or r < best[0]:
+                best = (r, f)
+        if best is None:
+            break
+        f = best[1]
+        freqs.append(f)
+        w = 2 * math.pi * f
+        cols += [np.sin(w * t), np.cos(w * t)]
+    A = np.vstack(cols).T
+    c, *_ = np.linalg.lstsq(A, y, rcond=None)
+    rms = float(np.sqrt(((A @ c - y) ** 2).mean()))
+    sines = []
+    for k, f in enumerate(freqs):
+        a, b = c[2 + 2 * k], c[3 + 2 * k]
+        sines.append([float(math.hypot(a, b)), float(f), float(math.atan2(b, a))])  # A sin(wt+phi) = A cos(phi) sin + A sin(phi) cos
+    return {"c0": float(c[0]), "v": float(c[1]), "sines": sines, "rms": rms, "range": [float(y.min()), float(y.max())]}
+
+
+def _reduce_strength(sock, layers, light):
+    """Reduce the node chain feeding a light's emission Strength to gain * (sum_i w_i * tex_i + bias) ^ gamma.
+    Supports Math ADD/SUBTRACT/MULTIPLY/DIVIDE/POWER with constants, Map Range (linear) and Image Texture leaves
+    (Color or Alpha output). Returns a dict or raises ValueError."""
+    if not sock.is_linked:
+        return {"w": {}, "bias": float(sock.default_value), "gamma": 1.0, "gain": 1.0, "clamp": False}
+    n = sock.links[0].from_node
+    if n.type == "TEX_IMAGE":
+        i = next(k for k, l in enumerate(layers) if l["node"] == n.name)
+        return {"w": {i: 1.0}, "bias": 0.0, "gamma": 1.0, "gain": 1.0, "clamp": False}
+    if n.type == "MAP_RANGE" and n.data_type == "FLOAT" and n.interpolation_type == "LINEAR":
+        f = _reduce_strength(n.inputs[0], layers, light)
+        a, b, c, d = (n.inputs[k].default_value for k in (1, 2, 3, 4))
+        if any(n.inputs[k].is_linked for k in (1, 2, 3, 4)) or abs(a) > 1e-6 or abs(c) > 1e-6:
+            raise ValueError(f"{light}: map range other than 0..b -> 0..d")
+        f["gain"] *= d / b
+        f["clamp"] = f["clamp"] or n.clamp
+        return f
+    if n.type == "MATH":
+        op = n.operation
+        lk = [i.is_linked for i in n.inputs[:2]]
+        if op in ("ADD", "SUBTRACT") and all(lk):
+            fa, fb = _reduce_strength(n.inputs[0], layers, light), _reduce_strength(n.inputs[1], layers, light)
+            if fa["gamma"] != 1 or fb["gamma"] != 1:
+                raise ValueError(f"{light}: sum of non-linear terms")
+            s = -1.0 if op == "SUBTRACT" else 1.0
+            w = {k: fa["gain"] * v for k, v in fa["w"].items()}
+            for k, v in fb["w"].items():
+                w[k] = w.get(k, 0.0) + s * fb["gain"] * v
+            return {"w": w, "bias": fa["gain"] * fa["bias"] + s * fb["gain"] * fb["bias"], "gamma": 1.0, "gain": 1.0, "clamp": False}
+        if lk[0] and not lk[1] or lk[1] and not lk[0]:
+            src = n.inputs[0] if lk[0] else n.inputs[1]
+            k = n.inputs[1].default_value if lk[0] else n.inputs[0].default_value
+            f = _reduce_strength(src, layers, light)
+            if op == "MULTIPLY" or (op == "DIVIDE" and lk[0]):
+                m = k if op == "MULTIPLY" else 1.0 / k
+                if f["gamma"] == 1.0:
+                    f["w"] = {i: v * m for i, v in f["w"].items()}
+                    f["bias"] *= m
+                else:
+                    f["gain"] *= m
+                return f
+            if op in ("ADD", "SUBTRACT") and f["gamma"] == 1.0 and f["gain"] == 1.0:
+                f["bias"] += k if op == "ADD" else (-k if lk[0] else k)
+                if op == "SUBTRACT" and lk[1]:
+                    raise ValueError(f"{light}: const - texture")
+                return f
+            if op == "POWER" and lk[0]:
+                f["gain"] = f["gain"] ** k
+                f["gamma"] *= k
+                return f
+        raise ValueError(f"{light}: unsupported math {op}")
+    raise ValueError(f"{light}: unsupported node {n.type} in the strength chain")
+
