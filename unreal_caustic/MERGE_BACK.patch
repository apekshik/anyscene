+                frames = np.arange(math.floor(k0), math.ceil(k1) + 1)
+                vals = [fc.evaluate(float(f)) for f in frames]
+                chans[key] = fit_channel(frames / fps, vals)
+                chans[key]["keys"] = len(fc.keyframe_points)
