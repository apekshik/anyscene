# Copy to web/.env.local (gitignored) and fill in. Restart `npm run dev` after changing it.

# Server only: the fal key the proxy adds to requests (never sent to the browser). `npm run env:local` writes it on
# Windows from the FAL_SERVERLESS_KEY user env var.
FAL_KEY=your-fal-key-id:your-fal-key-secret

# The fal apps the UI calls, as <your-fal-username>/<app-name> (deploy them from builder/, endpoint/, kit/).
# The proxy only forwards to these (plus fal storage uploads).
NEXT_PUBLIC_ANYSCENE_APP=your-fal-username/anyscene
NEXT_PUBLIC_ANYKIT_APP=your-fal-username/anykit
# Optional: the older plan + build pipeline (?mode=pipeline); defaults to NEXT_PUBLIC_ANYSCENE_APP.
# NEXT_PUBLIC_ANYSCENE_PIPELINE_APP=your-fal-username/anyscene-pipeline
# Optional: a second builder deployment the gallery can show with ?gallery_app=<id>.
# NEXT_PUBLIC_ANYSCENE_TEST_APP=your-fal-username/anyscene-builder

# Optional, server only: shared secret every proxied request must carry (required in production; the proxy is
# closed without it), and the per-IP job limit.
# ANYSCENE_ACCESS_KEY=choose-a-long-random-string
# ANYSCENE_JOBS_PER_HOUR=6

# Optional: extra dev-server origins (comma-separated hosts, e.g. your LAN IP) allowed to load dev assets.
# DEV_ORIGINS=192.168.1.20,*.local
